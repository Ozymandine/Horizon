# Render automatically sets PORT and RENDER_EXTERNAL_URL.
PORT=4100
STREAM_RELAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS
# For local use leave NODE_ENV and STREAM_PUBLIC_URL empty.
STREAM_PUBLIC_URL=
STREAM_PROVIDER_ORDER=miami,boise,orlando
# VidCore currently depends on this data-only server-side helper.
STREAM_CRYPTO_API_URL=https://enc-dec.app/api
# Override the historical native keys if the upstream protocol rotates.
STREAM_VIDPLAY_KEYS=
STREAM_VIDLINK_KEY=
STREAM_ALLOWED_HOSTS=
STREAM_MOVIE_EXTRACTOR_URL=
STREAM_SHOW_EXTRACTOR_URL=
