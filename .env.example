# Runtime connection (use your pooled PostgreSQL/Supabase connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct database connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# TMDB v3 API key or API Read Access Token. Keep these server-side; do not prefix with NEXT_PUBLIC_.
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""

# Optional expanded game listings. RAWG keys are used for upcoming and searchable game catalogs.
RAWG_API_KEY=""

# Optional live-event listings on music artist pages.
TICKETMASTER_API_KEY=""

# Optional licensed lyrics API key; configure with Musixmatch before displaying lyrics.
MUSIXMATCH_API_KEY=""

# Password-only access. The app uses AUTH_SECRET to sign private login sessions.
SITE_PASSWORD=""
AUTH_SECRET=""
# Vercel private playback: server-only settings, documented in docs/PRIVATE-STREAMING.md.
# Default fallback order: native VidSrc RC4, VidCore, VidLink, Embed.su.
# Set a custom JSON/HTML/HLS extractor to use that alone; placeholders below.
STREAM_MOVIE_EXTRACTOR_URL=""
STREAM_SHOW_EXTRACTOR_URL=""
STREAM_PROVIDER_ORDER=""
# Current VidCore/VidLink token formats use this server-side helper (never loaded in the browser).
STREAM_CRYPTO_API_URL="https://enc-dec.app/api"
# Optional rotated legacy keys: JSON array of two Vidplay RC4 keys / 32-byte Vidlink AES key in hex.
STREAM_VIDPLAY_KEYS=""
STREAM_VIDLINK_KEY=""
# Extra exact CDN/playlist/segment hostnames, comma separated. Verified built-in hosts are included.
STREAM_ALLOWED_HOSTS=""
STREAM_REFERER=""
# Optional separate secret; otherwise stable AUTH_SECRET encrypts playback tickets.
STREAM_TICKET_SECRET=""
