# Runtime connection (use your pooled PostgreSQL/Supabase connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct database connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# TMDB v3 API key or API Read Access Token. Keep these server-side; do not prefix with NEXT_PUBLIC_.
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""

# Optional expanded game listings. RAWG keys are used for upcoming and searchable game catalogs.
RAWG_API_KEY=""

# Optional live-event listings on music artist pages.
TICKETMASTER_API_KEY=""

# Optional licensed lyrics API key; configure with Musixmatch before displaying lyrics.
MUSIXMATCH_API_KEY=""

# Password-only access. The app uses AUTH_SECRET to sign private login sessions.
SITE_PASSWORD=""
AUTH_SECRET=""
